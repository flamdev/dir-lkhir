# Copiez ce fichier vers .env.local puis renseignez vos propres valeurs.
# .env.local n'est jamais commité (voir .gitignore).

# --- MongoDB Atlas -----------------------------------------------------
# Créez un cluster gratuit (M0) sur https://cloud.mongodb.com, un
# utilisateur de base de données, autorisez votre IP (ou 0.0.0.0/0 en dev),
# puis récupérez la chaîne de connexion via "Connect > Drivers".
MONGODB_URI=mongodb+srv://<utilisateur>:<mot-de-passe>@<cluster>.mongodb.net/dir-khir

# --- URL publique de l'application --------------------------------------
# Utilisée par les Server Components pour appeler les Route Handlers
# (fetch absolu) et par Better Auth pour construire ses cookies.
NEXT_PUBLIC_URL=http://localhost:3000

# --- Better Auth ---------------------------------------------------------
# Clé secrète utilisée pour signer les sessions. Générez-en une avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (ou `openssl rand -base64 32` dans un terminal Unix/Git Bash)
BETTER_AUTH_SECRET=remplacez-moi-par-une-chaine-aleatoire-longue-et-secrete
BETTER_AUTH_URL=http://localhost:3000